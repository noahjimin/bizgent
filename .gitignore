# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# ===== BizGent 팀 추가 규칙 =====

# 빌드 결과물 (Gradle / Maven)
build/
target/
.gradle/
out/

# IDE 설정 (IntelliJ, VS Code, Eclipse)
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# 비밀 정보: API 키, DB 비밀번호 (절대 커밋 금지)
.env
.env.*
application-secret.yml
application-local.yml

# 업로드 파일 (매출 엑셀, 영수증 사진 등)
uploads/

# OS 자동 생성 파일
.DS_Store
Thumbs.db
desktop.ini

# Obsidian 개인 설정
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# 대용량 영상
*.mp4

# Gradle Wrapper jar는 커밋 (위 *.jar 규칙의 예외)
!gradle/wrapper/gradle-wrapper.jar
